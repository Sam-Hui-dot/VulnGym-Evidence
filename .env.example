# Copy to .env locally. Never commit the real value.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
VULNGYM_OPENROUTER_MODEL=z-ai/glm-5.3-flash

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
VULNGYM_DEEPSEEK_MODEL=deepseek-v4-flash
# Use high/max for difficult semantic audits; none is the low-cost default.
VULNGYM_DEEPSEEK_REASONING_EFFORT=none
# Online DeepSeek calls remain blocked until explicitly enabled for one run.
VULNGYM_DEEPSEEK_ENABLED=false

DASHSCOPE_API_KEY=replace-with-your-dashscope-key
VULNGYM_QWEN_MODEL=qwen3.8-flash
VULNGYM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VULNGYM_QWEN_ENABLE_THINKING=false
# Online Qwen calls remain blocked until explicitly enabled for one run.
VULNGYM_QWEN_ENABLED=false

# Optional overrides:
# VULNGYM_OPENROUTER_TIMEOUT_SECONDS=180
# VULNGYM_OPENROUTER_MAX_TOKENS=8192
# VULNGYM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VULNGYM_DEEPSEEK_TIMEOUT_SECONDS=180
# VULNGYM_DEEPSEEK_MAX_TOKENS=8192
# VULNGYM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# VULNGYM_QWEN_TIMEOUT_SECONDS=180
# VULNGYM_QWEN_MAX_TOKENS=8192
